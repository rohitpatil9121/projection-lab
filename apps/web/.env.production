# ⚠ THIS FILE IS COMMITTED AND EVERY VALUE IN IT IS PUBLIC.
# Vite inlines VITE_* vars into the JS bundle, so anything here is readable by
# anyone who downloads the APK/AAB or opens devtools. It is tracked on purpose —
# a clean clone needs these to build. NEVER put a secret here: no API keys, no
# OAuth client *secrets*, no JWT secret, no DB URL. Server secrets belong in
# apps/api/.env (gitignored) and are set on the host, never in the client.

VITE_API_URL=https://projection-lab.onrender.com

# Google Sign-In — the WEB client ID (public by design; it ships in the bundle).
# The API verifies every ID token against this same value as GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=103128869471-b2fmcg7pinr1igftm5rmjocfv0lj6i5t.apps.googleusercontent.com
